# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram chat ID (only this user can use the bot)
ADMIN_CHAT_ID=123456789

# Public HTTPS base URL for Telegram webhooks (required in production).
# Example: https://your-space.hf.space or https://your.domain.com
# Leave empty to use long polling (local development only).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Optional shared secret; Telegram sends it as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Google AI Studio / Gemini API key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Hugging Face Inference Providers (for /hugging_face video generation)
HF_TOKEN=hf_your_token_with_inference_providers
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B
HF_PROVIDER=auto
HF_TARGET_DURATION_SECONDS=12

# Pixabay Video API (for /pixabay stock Shorts)
# Get a free key at https://pixabay.com/api/docs/ (log in to see it)
PIXABAY_API_KEY=your_pixabay_api_key

# YouTube OAuth (download client_secret.json from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
# Force-refresh YouTube access token this often and notify ADMIN_CHAT_ID
YOUTUBE_TOKEN_REFRESH_HOURS=24

# Local storage
VIDEO_STORAGE_DIR=storage/videos
SESSION_TTL_HOURS=24
